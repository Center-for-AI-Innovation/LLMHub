# API settings
API_V1_STR=/api
PROJECT_NAME="AI Inference Backend"

# CORS settings
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_service

# HPC settings
SLURM_ACCOUNT="your_slurm_account"
VEC_INF_ACCOUNT="your_slurm_account"
VEC_INF_CONFIG_DIR=/sw/llmhub/llm-serving-backend-config
VEC_INF_WORK_DIR=/path/to/workdir
VEC_INF_LOG_DIR=/path/to/logdir
VEC_INF_SHARED_WORK_ROOT=/projects/llmhub
# Shared HF and torch inductor caches, cleaned by scripts/evict_unused_models.py
MODEL_CACHE_DIR=/projects/modelcache/public/huggingface
COMPILE_CACHE_DIR=/projects/modelcache/public/torch_inductor
VEC_INF_EXECUTION_MODE=direct
# VEC_INF_IMPERSONATE_SCRIPT=/path/to/llm-serving-backend/scripts/impersonate-wrapper.py
# VEC_INF_IMPERSONATE_PYTHON=/sw/llmhub/<shared-env>/bin/python
# VEC_INF_IMPERSONATE_LOGIN_SHELL=true
# Comma-separated KEY=VALUE pairs that are forwarded into the container job environment.
# On Delta, HF_HUB_CACHE must be the real host path (vec-inf mounts it as-is); a /root/... path
# breaks the container. TORCHINDUCTOR_CACHE_DIR is the container path from environment.yaml's bind.
# VEC_INF_ENV=HF_HUB_CACHE=/projects/modelcache/public/huggingface,TORCHINDUCTOR_CACHE_DIR=/root/.cache/torch_inductor

# Background service settings
SYNC_INTERVAL=60
EXPIRY_CHECK_INTERVAL=3000
MAX_DEPLOYMENTS_PER_CYCLE=10

# Email settings (unauthenticated campus SMTP relay — must run on a campus IP)
SMTP_HOST=outbound-relays.techservices.illinois.edu
SMTP_PORT=25
SMTP_FROM=no-reply@illinois.edu
# Base URL of the Next.js frontend; when set, access-granted emails link to it
# FRONTEND_URL=https://llmhub.example.illinois.edu
# Support contact; when set, the "contact your system administrator" line in
# notification emails becomes "... at <SUPPORT_EMAIL>"
# SUPPORT_EMAIL=llmhub-support@illinois.edu

# Point the fit estimator at a non-Delta cluster: a hardware YAML generated by
#   python -m app.services.fit_estimator.discovery --output hardware.yaml
# FIT_ESTIMATOR_HARDWARE_YAML=/path/to/hardware.yaml
