# LLMHub on NCSA Delta — non-secret deployment configuration.
#
# COMMITTED TO GIT. Never put a credential here; secrets live in secrets.env
# (mode 0600, outside git). See secrets.env.example.
#
# Sourced by every script in ../bin/. Any value can be overridden by exporting
# it before invoking a script, e.g.:
#
#   LLMHUB_PROFILE=staging ./bin/deploy.sh --apply

# ---------------------------------------------------------------- source ----
LLMHUB_REPO="${LLMHUB_REPO:-https://github.com/Center-for-AI-Innovation/LLMHub.git}"

# Pin a TAG, never a branch. A deployment sitting on a moving branch is how the
# previous Delta deployment ended up on `launch_model_integration` with nobody
# able to say what was running.
LLMHUB_REF="${LLMHUB_REF:-v0.1.1}"

# ------------------------------------------------------------- identities ----
# Service account that owns /sw/llmhub and should run the service.
LLMHUB_SERVICE_USER="${LLMHUB_SERVICE_USER:-svcdeltallmhub}"
LLMHUB_GROUP="${LLMHUB_GROUP:-delta_bfmz}"

# Group-writable so co-maintainers can operate the deployment.
LLMHUB_UMASK="${LLMHUB_UMASK:-007}"

# ------------------------------------------------------------------ paths ----
# Deployment root. Keep this OUT of any directory holding developer working
# copies — build artifacts and someone's in-progress branch must never share a
# tree.
LLMHUB_DEPLOY_ROOT="${LLMHUB_DEPLOY_ROOT:-/projects/bfmz/svcdeltallmhub/llmhub-${LLMHUB_REF}}"
LLMHUB_SRC_DIR="${LLMHUB_SRC_DIR:-${LLMHUB_DEPLOY_ROOT}/LLMHub}"
LLMHUB_VENV_DIR="${LLMHUB_VENV_DIR:-${LLMHUB_DEPLOY_ROOT}/venv}"
LLMHUB_UV_DIR="${LLMHUB_UV_DIR:-${LLMHUB_DEPLOY_ROOT}/.uvenv}"
LLMHUB_LOG_DIR="${LLMHUB_LOG_DIR:-${LLMHUB_DEPLOY_ROOT}/logs}"
LLMHUB_RUN_DIR="${LLMHUB_RUN_DIR:-${LLMHUB_DEPLOY_ROOT}/run}"
LLMHUB_SECRETS_FILE="${LLMHUB_SECRETS_FILE:-${LLMHUB_DEPLOY_ROOT}/secrets.env}"

# --------------------------------------------------------------- runtime -----
# Python for the backend venv. uv downloads a standalone interpreter, so this
# does not depend on a system Python (the VM ships only 3.9, below the
# backend's >=3.10 floor).
LLMHUB_PYTHON_VERSION="${LLMHUB_PYTHON_VERSION:-3.11}"

# Bind address. Access is via SSH tunnel; do not bind 0.0.0.0 without a
# deliberate decision about who can reach the port.
LLMHUB_BIND_HOST="${LLMHUB_BIND_HOST:-127.0.0.1}"

# ------------------------------------------------------------------ ports ----
LLMHUB_PG_PORT="${LLMHUB_PG_PORT:-5433}"
LLMHUB_BACKEND_PORT="${LLMHUB_BACKEND_PORT:-8000}"
LLMHUB_FRONTEND_PORT="${LLMHUB_FRONTEND_PORT:-3000}"

# `LLMHUB_PROFILE=staging` shifts every port by +100 so a staging stack can run
# beside production on the same VM.
if [ "${LLMHUB_PROFILE:-production}" = "staging" ]; then
    LLMHUB_PG_PORT="${LLMHUB_PG_PORT_STAGING:-5533}"
    LLMHUB_BACKEND_PORT="${LLMHUB_BACKEND_PORT_STAGING:-8100}"
    LLMHUB_FRONTEND_PORT="${LLMHUB_FRONTEND_PORT_STAGING:-3100}"
fi

# --------------------------------------------------------------- database ----
# LLMHUB_PG_MODE:
#   local    run a throwaway PostgreSQL in Apptainer (default; safe for staging)
#   external use LLMHUB_DATABASE_URL as-is, set in secrets.env
LLMHUB_PG_MODE="${LLMHUB_PG_MODE:-local}"
LLMHUB_PG_IMAGE="${LLMHUB_PG_IMAGE:-docker://postgres:15}"
LLMHUB_PG_DB="${LLMHUB_PG_DB:-llm_service}"
LLMHUB_PG_USER="${LLMHUB_PG_USER:-postgres}"

# /projects is Lustre and mounted nodev, so PostgreSQL data and the Apptainer
# cache MUST live on a local filesystem. /var/tmp is mode 1777 and works.
LLMHUB_VAR_TMP="${LLMHUB_VAR_TMP:-/var/tmp}"
LLMHUB_PG_ROOT="${LLMHUB_PG_ROOT:-${LLMHUB_VAR_TMP}/llmhub-${LLMHUB_PROFILE:-production}-pg-${USER}}"

# ------------------------------------------------------------------ slurm ----
LLMHUB_SLURM_ACCOUNT="${LLMHUB_SLURM_ACCOUNT:-bfmz-delta-gpu}"

# ---------------------------------------------------------------- vec-inf ----
# Pinned by backend/pyproject.toml; asserted after install.
LLMHUB_VEC_INF_VERSION="${LLMHUB_VEC_INF_VERSION:-0.9.0}"

# Shared job-log root used by the Delta infrastructure config as log_dir.
LLMHUB_VEC_INF_LOG_DIR="${LLMHUB_VEC_INF_LOG_DIR:-/projects/llmhub}"
LLMHUB_VEC_INF_WORK_DIR="${LLMHUB_VEC_INF_WORK_DIR:-${LLMHUB_DEPLOY_ROOT}/slurm-logs}"

# Container environment passed into inference jobs. The offline flags keep
# jobs from reaching out to the Hugging Face hub from compute nodes.
LLMHUB_VEC_INF_ENV="${LLMHUB_VEC_INF_ENV:-HF_HOME=/root/.cache/huggingface,HF_HUB_CACHE=/root/.cache/huggingface,TORCHINDUCTOR_CACHE_DIR=/root/.cache/torch_inductor,HF_HUB_OFFLINE=1,TRANSFORMERS_OFFLINE=1}"

# NOTE: as of v0.1.1, backend/app/main.py unconditionally overwrites
# VEC_INF_CONFIG_DIR with the auto-detected in-repo infrastructure directory
# (config/infrastructures/<id>/). Setting it in .env has no effect at that
# version. Detection resolves to `delta` correctly on dt-svc-llmaas01.
LLMHUB_VEC_INF_CONFIG_DIR="${LLMHUB_VEC_INF_CONFIG_DIR:-}"

# --- Per-user impersonation ---------------------------------------------
# These keys exist only once PR #40 / #49 land. On v0.1.1 config.py does not
# define them and they are silently ignored, so the scripts omit them unless
# LLMHUB_EXECUTION_MODE is set explicitly.
LLMHUB_EXECUTION_MODE="${LLMHUB_EXECUTION_MODE:-}"
LLMHUB_SHARED_WORK_ROOT="${LLMHUB_SHARED_WORK_ROOT:-/projects/llmhub}"
LLMHUB_IMPERSONATE_SCRIPT="${LLMHUB_IMPERSONATE_SCRIPT:-}"
LLMHUB_IMPERSONATE_PYTHON="${LLMHUB_IMPERSONATE_PYTHON:-}"
LLMHUB_ACCOUNTS_SCRIPT="${LLMHUB_ACCOUNTS_SCRIPT:-/sw/user/scripts/accounts}"

# ------------------------------------------------------------- containers ----
# Referenced by config/infrastructures/delta/environment.yaml as image_path.
LLMHUB_VLLM_SIF="${LLMHUB_VLLM_SIF:-/sw/llmhub/vllm.sif}"
# What devops/apptainers/build_vllm_sif.sbatch currently builds.
LLMHUB_VLLM_IMAGE_EXPECTED="${LLMHUB_VLLM_IMAGE_EXPECTED:-docker://vllm/vllm-openai:v0.19.1}"

LLMHUB_APPTAINER_CACHEDIR="${LLMHUB_APPTAINER_CACHEDIR:-${LLMHUB_VAR_TMP}/llmhub-apptainer-cache-${USER}}"
LLMHUB_APPTAINER_TMPDIR="${LLMHUB_APPTAINER_TMPDIR:-${LLMHUB_VAR_TMP}/llmhub-apptainer-tmp-${USER}}"

# ----------------------------------------------------------------- policy ----
# Refuse to run unless we are the service user. Set to 0 for read-only
# inspection, or for a personal staging stack that touches nothing shared.
REQUIRE_SERVICE_USER="${REQUIRE_SERVICE_USER:-1}"

# -------------------------------------------------------------------- host ---
LLMHUB_VM_HOST="${LLMHUB_VM_HOST:-dt-svc-llmaas01.delta.ncsa.illinois.edu}"

# The site manages host trust centrally in /etc/ssh/ssh_known_hosts and sets
# UserKnownHostsFile=/dev/null for dt-svc* — you cannot add your own exception.
# The ed25519 entry for this VM is stale; the ecdsa entry is current, so
# pinning ecdsa verifies against the site file WITHOUT weakening checking.
LLMHUB_SSH_OPTS="${LLMHUB_SSH_OPTS:--o HostKeyAlgorithms=ecdsa-sha2-nistp256}"
