# LLMHub on NCSA Delta — non-secret deployment configuration. COMMITTED.
#
# Never put a credential here: secrets live in $LLMHUB_SECRETS_FILE (0600,
# outside git) — see secrets.env.example. Every value is a default
# (VAR="${VAR:-…}"), so export to override:  LLMHUB_NODE_VERSION=24.20.0 ./llmhub deploy

# production: canonical ports, must run as the service user.
# staging:    +100 ports, any account, runs beside production on the same VM.
LLMHUB_PROFILE="${LLMHUB_PROFILE:-production}"

# ---------------------------------------------------------------- source ----
LLMHUB_REPO="${LLMHUB_REPO:-https://github.com/Center-for-AI-Innovation/LLMHub.git}"
# Default ref. Production pins a release TAG. Staging usually tracks a branch
# via --ref; either way the deployed ref + SHA are recorded in
# $LLMHUB_DEPLOY_ROOT/DEPLOYED and reused by later commands.
LLMHUB_REF="${LLMHUB_REF:-v0.1.1}"

# ------------------------------------------------------------ identities ----
LLMHUB_SERVICE_USER="${LLMHUB_SERVICE_USER:-svcdeltallmhub}"
LLMHUB_GROUP="${LLMHUB_GROUP:-delta_bfmz}"
LLMHUB_UMASK="${LLMHUB_UMASK:-007}"        # group-writable: the group co-maintains

# ---------------------------------------------- paths on /projects (Lustre) --
# Source checkout, venv, node, logs. Survives VM rebuilds. Never inside a
# directory that holds someone's working copy.
LLMHUB_BASE="${LLMHUB_BASE:-/projects/bfmz/${USER}}"
LLMHUB_DEPLOY_ROOT="${LLMHUB_DEPLOY_ROOT:-${LLMHUB_BASE}/llmhub-${LLMHUB_PROFILE}}"
# Per-stack overrides are sourced HERE, before every other default, so any value
# below (an image path, the execution mode, a local root) can be pinned for one
# stack without editing this file or exporting on every command.
# shellcheck disable=SC1091
[ -r "${LLMHUB_DEPLOY_ROOT}/local.env" ] && . "${LLMHUB_DEPLOY_ROOT}/local.env"
LLMHUB_SRC_DIR="${LLMHUB_SRC_DIR:-${LLMHUB_DEPLOY_ROOT}/LLMHub}"
LLMHUB_VENV_DIR="${LLMHUB_VENV_DIR:-${LLMHUB_DEPLOY_ROOT}/venv}"
LLMHUB_UV_DIR="${LLMHUB_UV_DIR:-${LLMHUB_DEPLOY_ROOT}/.uv}"
# Node lives on the local root: it is a download, and /projects has an inode
# quota (see LLMHUB_LOCAL_ROOT) — defined below, after the local root.
LLMHUB_LOG_DIR="${LLMHUB_LOG_DIR:-${LLMHUB_DEPLOY_ROOT}/logs}"
LLMHUB_RUN_DIR="${LLMHUB_RUN_DIR:-${LLMHUB_DEPLOY_ROOT}/run}"
LLMHUB_SECRETS_FILE="${LLMHUB_SECRETS_FILE:-${LLMHUB_DEPLOY_ROOT}/secrets.env}"

# ------------------------------------------------- paths on local disk ------
# /projects is Lustre mounted nodev: PostgreSQL and Apptainer cannot live
# there. /var/tmp is tmpfs (RAM — a database there vanishes on reboot, which
# happened 2026-08-25) and /tmp is a 4 G partition. /data is a 150 G xfs
# volume owned by the service user, group delta_bfmz — the durable home.
if [ "$USER" = "$LLMHUB_SERVICE_USER" ]; then
    LLMHUB_LOCAL_ROOT="${LLMHUB_LOCAL_ROOT:-/data/llmhub/${LLMHUB_PROFILE}}"
else   # a personal stack never shares Postgres data with the service user's
    LLMHUB_LOCAL_ROOT="${LLMHUB_LOCAL_ROOT:-/data/llmhub/${LLMHUB_PROFILE}-${USER}}"
fi
LLMHUB_PG_DIR="${LLMHUB_PG_DIR:-${LLMHUB_LOCAL_ROOT}/pg}"        # data/, socket, password
# Rebuildable, inode-heavy things live here too: /projects/bfmz carries a
# project INODE quota (750k soft / 825k hard) and one frontend install is
# ~150k files (node_modules + pnpm store). Two stacks on /projects blew it on
# 2026-08-27 ("Disk quota exceeded", surfacing as pnpm ENOENT). Nothing here
# survives a VM rebuild; deploy recreates all of it.
LLMHUB_CACHE_DIR="${LLMHUB_CACHE_DIR:-${LLMHUB_LOCAL_ROOT}/cache}"          # uv, uv-python, npm, pnpm store, XDG
LLMHUB_NODE_DIR="${LLMHUB_NODE_DIR:-${LLMHUB_LOCAL_ROOT}/node}"             # Node runtime + pnpm
# The frontend runs from a VM-local WORKING COPY of the checkout's frontend/
# (rsync on every deploy): node_modules, .next and .env all live here. pnpm
# refuses a symlinked node_modules and ignores --modules-dir in a workspace,
# so relocating only node_modules is not an option.
LLMHUB_FRONTEND_DIR="${LLMHUB_FRONTEND_DIR:-${LLMHUB_LOCAL_ROOT}/frontend}"
LLMHUB_PG_SIF="${LLMHUB_PG_SIF:-${LLMHUB_LOCAL_ROOT}/postgres.sif}"
LLMHUB_APPTAINER_CACHEDIR="${LLMHUB_APPTAINER_CACHEDIR:-${LLMHUB_LOCAL_ROOT}/apptainer/cache}"
LLMHUB_APPTAINER_TMPDIR="${LLMHUB_APPTAINER_TMPDIR:-${LLMHUB_LOCAL_ROOT}/apptainer/tmp}"

# -------------------------------------------------------------- runtimes ----
# The VM has Python 3.9 (backend needs >=3.10) and no node/pnpm/uv. deploy
# fetches all of these into the deployment tree.
LLMHUB_PYTHON_VERSION="${LLMHUB_PYTHON_VERSION:-3.11}"   # uv-managed standalone CPython
LLMHUB_NODE_VERSION="${LLMHUB_NODE_VERSION:-24.20.0}"    # LTS; Next 16 needs >=20.9
LLMHUB_PNPM_VERSION="${LLMHUB_PNPM_VERSION:-10.34.5}"    # frontend/pnpm-lock.yaml is lockfileVersion 9.0
LLMHUB_VEC_INF_VERSION="${LLMHUB_VEC_INF_VERSION:-0.9.0}" # informational; backend/pyproject.toml pins it

# --------------------------------------------------------------- network ----
# Everything binds loopback; users reach it through an SSH tunnel (or a
# reverse proxy in front of the VM). Do not bind 0.0.0.0 without deciding
# who may reach the ports.
LLMHUB_BIND_HOST="${LLMHUB_BIND_HOST:-127.0.0.1}"
LLMHUB_PG_PORT="${LLMHUB_PG_PORT:-5433}"
LLMHUB_BACKEND_PORT="${LLMHUB_BACKEND_PORT:-8000}"
LLMHUB_FRONTEND_PORT="${LLMHUB_FRONTEND_PORT:-3000}"
LLMHUB_VEC_INF_LOG_DIR="${LLMHUB_VEC_INF_LOG_DIR:-/projects/llmhub}"   # shared job-log root
if [ "$LLMHUB_PROFILE" = staging ]; then
    LLMHUB_PG_PORT="${LLMHUB_PG_PORT_STAGING:-5533}"
    LLMHUB_BACKEND_PORT="${LLMHUB_BACKEND_PORT_STAGING:-8100}"
    LLMHUB_FRONTEND_PORT="${LLMHUB_FRONTEND_PORT_STAGING:-3100}"
    LLMHUB_VEC_INF_LOG_DIR="${LLMHUB_VEC_INF_LOG_DIR_STAGING:-${LLMHUB_DEPLOY_ROOT}/slurm-logs}"
fi
# Origin the browser uses. Better Auth and the CILogon redirect URI are built
# from it, and it is baked into the frontend build — change it, redeploy.
LLMHUB_PUBLIC_URL="${LLMHUB_PUBLIC_URL:-http://localhost:${LLMHUB_FRONTEND_PORT}}"

# -------------------------------------------------------------- database ----
# local:    PostgreSQL in Apptainer on this VM, data under LLMHUB_PG_DIR,
#           scram password generated at initdb (LLMHUB_PG_DIR/password).
# external: use LLMHUB_DATABASE_URL from secrets.env as-is.
LLMHUB_PG_MODE="${LLMHUB_PG_MODE:-local}"
LLMHUB_PG_IMAGE="${LLMHUB_PG_IMAGE:-docker://postgres:15}"
LLMHUB_PG_DB="${LLMHUB_PG_DB:-llm_service}"
LLMHUB_PG_USER="${LLMHUB_PG_USER:-postgres}"

# ------------------------------------------------------- slurm / vec-inf ----
LLMHUB_SLURM_ACCOUNT="${LLMHUB_SLURM_ACCOUNT:-bfmz-delta-gpu}"
LLMHUB_VEC_INF_WORK_DIR="${LLMHUB_VEC_INF_WORK_DIR:-${LLMHUB_DEPLOY_ROOT}/slurm-logs}"
# Forwarded into inference jobs (vec-inf turns it into `apptainer exec --env
# K=V,K=V`); the offline flags stop compute nodes from reaching for the
# Hugging Face hub. FI_LOG_PROV=none silences libfabric: the Slingshot image
# sets FI_LOG_LEVEL=warn, the CXI provider then logs endpoint-close warnings
# to stderr, and vec-inf marks the job FAILED on the first stderr line
# matching "unable to" before the server is up (jobs 21500607, 21500755:
# healthy, TP=4 weights loaded, killed on a `<warn>`). FI_LOG_LEVEL only
# accepts warn|trace|info|debug (anything else falls back to warn), so the
# provider filter is the switch that works from outside the image. The last
# entry works around an upstream bug: the backend
# appends CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES unless the string already
# names it, and apptainer splits --env on commas, so any multi-GPU job
# (0,1,2,3) dies with "1 must be formatted as key=value". A CSV-quoted field
# — literal \" reaching bash, which passes the quotes through — survives
# vec-inf's split/rejoin and apptainer's parser (measured on 1.5.1). Written
# to backend/.env UNQUOTED so dotenv keeps the backslashes and does not
# expand $CUDA_VISIBLE_DEVICES; SLURM expands it on the node.
LLMHUB_VEC_INF_ENV="${LLMHUB_VEC_INF_ENV:-HF_HOME=/root/.cache/huggingface,HF_HUB_CACHE=/root/.cache/huggingface,TORCHINDUCTOR_CACHE_DIR=/root/.cache/torch_inductor,HF_HUB_OFFLINE=1,TRANSFORMERS_OFFLINE=1,FI_LOG_PROV=none,\\\"CUDA_VISIBLE_DEVICES=\$CUDA_VISIBLE_DEVICES\\\"}"
# direct: jobs run as the account running the backend.
# impersonate: jobs run as svcllmhub<netid> (needs the service user's sudo
#   rights and PR #40 — see backend/scripts/check-impersonation-setup.py).
# Keys the deployed backend does not define are never written (its Settings
# model forbids unknown keys), so these are safe to set for any version.
LLMHUB_EXECUTION_MODE="${LLMHUB_EXECUTION_MODE:-direct}"
LLMHUB_SHARED_WORK_ROOT="${LLMHUB_SHARED_WORK_ROOT:-/projects/llmhub}"
LLMHUB_IMPERSONATE_SCRIPT="${LLMHUB_IMPERSONATE_SCRIPT:-}"   # empty = backend default (in-repo wrapper)
LLMHUB_IMPERSONATE_PYTHON="${LLMHUB_IMPERSONATE_PYTHON:-}"   # empty = $LLMHUB_SHIM_ENV/bin/python in impersonate mode
LLMHUB_ACCOUNTS_SCRIPT="${LLMHUB_ACCOUNTS_SCRIPT:-}"         # empty = backend default (/sw/user/scripts/accounts)

# Impersonated launches run as svcllmhub<netid> — a different Unix user whose
# groups (grp_202, delta_bgns) cannot read anything under /projects/bfmz/….
# Everything that user must read lives under LLMHUB_SHARED_ROOT — owned by the
# service user, world-readable (/projects/llmhub is drwxr-xr-x): the rendered
# vec-inf config, a copy of the inference image, and the SHIM ENV — a second,
# NON-editable install of the deployed backend that
# `sudo -u svcllmhub<netid> python -m app.utils.vec_inf_launch_shim` runs.
# deploy rebuilds the shim env whenever the deployed ref changes, so the two
# copies of the launch code cannot drift. Impersonate mode is therefore
# service-user-only: the sudo edge is svcdeltallmhub → svcllmhub*, and only
# svcdeltallmhub can write under /projects/llmhub (workspaces, shared root).
LLMHUB_SHARED_ROOT="${LLMHUB_SHARED_ROOT:-/projects/llmhub/llmhub-${LLMHUB_PROFILE}}"
LLMHUB_SHIM_ENV="${LLMHUB_SHIM_ENV:-${LLMHUB_SHARED_ROOT}/shim-env}"
# Target of launch-test / check-impersonation in impersonate mode, e.g. svcllmhubdadams.
LLMHUB_TEST_CLUSTER_USER="${LLMHUB_TEST_CLUSTER_USER:-}"
LLMHUB_SYNC_INTERVAL="${LLMHUB_SYNC_INTERVAL:-60}"
LLMHUB_EXPIRY_CHECK_INTERVAL="${LLMHUB_EXPIRY_CHECK_INTERVAL:-3000}"
LLMHUB_MAX_DEPLOYMENTS_PER_CYCLE="${LLMHUB_MAX_DEPLOYMENTS_PER_CYCLE:-10}"

# ------------------------------------------------------------- inference ----
# deploy renders backend/config/infrastructures/delta/environment.yaml into
# $LLMHUB_DEPLOY_ROOT/vec-inf-config/ with these values and points the backend
# at it (VEC_INF_CONFIG_DIR), so a staging stack can run a different image or
# partition without touching /sw/llmhub or the checkout.
LLMHUB_VLLM_SIF="${LLMHUB_VLLM_SIF:-/sw/llmhub/vllm.sif}"
LLMHUB_HF_CACHE="${LLMHUB_HF_CACHE:-/projects/modelcache/public/huggingface}"   # bound to /root/.cache/huggingface (read-only use)
# vLLM 0.19's compile step WRITES to the torch-inductor cache. The shared one is
# rwx only for svcdeltallmhub and the svcllmhub<netid> accounts (ACL), so a
# direct-mode stack run as anyone else gets its own (job 21500755 died with
# PermissionError on /root/.cache/torch_inductor/vc).
if [ "$USER" = "$LLMHUB_SERVICE_USER" ]; then
    LLMHUB_TORCH_CACHE="${LLMHUB_TORCH_CACHE:-/projects/modelcache/public/torch_inductor}"
else
    LLMHUB_TORCH_CACHE="${LLMHUB_TORCH_CACHE:-${LLMHUB_DEPLOY_ROOT}/torch-inductor}"
fi
LLMHUB_MODEL_WEIGHTS_PARENT_DIR="${LLMHUB_MODEL_WEIGHTS_PARENT_DIR:-/projects/modelcache/public}"
LLMHUB_LAUNCH_PARTITION="${LLMHUB_LAUNCH_PARTITION:-gpuA100x4-interactive}"
LLMHUB_LAUNCH_RESOURCE_TYPE="${LLMHUB_LAUNCH_RESOURCE_TYPE:-nvidia_a100}"   # Delta GRES name: gpu:<type>:<n>
LLMHUB_LAUNCH_TIME="${LLMHUB_LAUNCH_TIME:-00:30:00}"

# The backend keeps its own GPU bookkeeping (ResourceAllocation GPU/default)
# and refuses any launch with num_gpus set until a pool exists. `start` seeds
# it with this many GPUs. It caps concurrent allocations in the backend only —
# SLURM enforces the real limits.
LLMHUB_GPU_POOL="${LLMHUB_GPU_POOL:-400}"

# launch-test: one real inference job through the backend API (a SLURM job
# as the account running the backend), a chat completion, then shutdown.
# The model must be in the catalogue AND present in LLMHUB_HF_CACHE.
LLMHUB_TEST_MODEL="${LLMHUB_TEST_MODEL:-Qwen2.5-7B-Instruct}"
LLMHUB_TEST_HF_MODEL="${LLMHUB_TEST_HF_MODEL:-Qwen/Qwen2.5-7B-Instruct}"
LLMHUB_TEST_GPUS="${LLMHUB_TEST_GPUS:-4}"       # >1 ⇒ tensor parallel across them
LLMHUB_TEST_NODES="${LLMHUB_TEST_NODES:-1}"     # >1 ⇒ vec-inf's Ray launcher (image needs ray)
LLMHUB_TEST_USER_ID="${LLMHUB_TEST_USER_ID:-}"  # only needed with LLMHUB_PG_MODE=external


# ------------------------------------------------------------------ host ----
LLMHUB_VM_HOST="${LLMHUB_VM_HOST:-dt-svc-llmaas01.delta.ncsa.illinois.edu}"
# Host trust is centrally managed (/etc/ssh/ssh_known_hosts, no personal
# exceptions for dt-svc*). The site's ed25519 entry for this VM is stale
# since its 2026-06-02 re-image; the ecdsa entry is current, so pinning ecdsa
# verifies against the site file WITHOUT weakening checking.
LLMHUB_SSH_OPTS="${LLMHUB_SSH_OPTS:--o HostKeyAlgorithms=ecdsa-sha2-nistp256}"
