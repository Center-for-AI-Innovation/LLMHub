# LLMHub on Delta — secrets TEMPLATE. This file is committed; the filled-in
# copy is not. `llmhub deploy` creates $LLMHUB_SECRETS_FILE from it on first
# run (mode 0600, outside the git checkout), generating the two values marked
# "generated". Fill in the rest by hand and redeploy. Quote values that
# contain spaces or shell metacharacters: KEY='value'.

# ------------------------------------------------------------- backend -----
# Access-granted notification email. The campus relay needs no credentials
# from campus hosts. Leave SMTP_HOST empty to disable email entirely.
SMTP_HOST=outbound-relays.techservices.illinois.edu
SMTP_PORT=25
SMTP_FROM=no-reply@illinois.edu
SUPPORT_EMAIL=

# Only for LLMHUB_PG_MODE=external.
#LLMHUB_DATABASE_URL=postgresql://user:password@host:5432/llmhub

# ------------------------------------------------------------ frontend -----
# generated: Better Auth session secret.
BETTER_AUTH_SECRET=
# generated: pepper for hashing user API keys. ROTATING IT INVALIDATES EVERY
# EXISTING USER API KEY — keep it stable across redeploys.
USER_API_KEY_PEPPER=

# CILogon OAuth, registered by the LLMHub maintainers (not self-serve). The
# redirect URI is <LLMHUB_PUBLIC_URL>/api/auth/oauth2/callback/cilogon.
# Both empty ⇒ CILogon is off and the frontend uses local accounts.
CILOGON_CLIENT_ID=
CILOGON_CLIENT_SECRET=
CILOGON_DISCOVERY_URL=https://cilogon.org/.well-known/openid-configuration
CILOGON_SKIN=illinois-chat

# Always-on vLLM endpoint behind the default chat experience.
ALWAYS_ON_VLLM_BASE_URL=
ALWAYS_ON_VLLM_API_KEY=
ALWAYS_ON_VLLM_MODEL=
# Optional OpenAI-backed models.
OPENAI_API_KEY=

# S3-compatible storage for chat attachments (unset ⇒ uploads unavailable).
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_SIGNED_URL_TTL_SECONDS=
