# LLMHub on Delta — secret configuration TEMPLATE.
#
# Copy to the path in LLMHUB_SECRETS_FILE, fill in, and lock it down:
#   cp secrets.env.example "$LLMHUB_SECRETS_FILE"
#   chmod 0600 "$LLMHUB_SECRETS_FILE"
#
# THIS FILE IS COMMITTED. The filled-in copy MUST NOT BE — keep it out of the
# deployment tree's git checkout, or add it to .gitignore.
#
# A backend-only deployment needs almost nothing here: only the SMTP_* values,
# and those are optional. Everything else is required once the frontend is
# deployed.

# ============================================================== backend =====
# Access-granted notification email (added in v0.1.1). The Illinois relay does
# not require credentials from campus hosts.
SMTP_HOST=outbound-relays.techservices.illinois.edu
SMTP_PORT=25
SMTP_FROM=no-reply@illinois.edu

# Only used when LLMHUB_PG_MODE=external. Leave unset for the local
# Apptainer PostgreSQL, which connects over a unix socket without a password.
#LLMHUB_DATABASE_URL=postgresql://user:password@host:5432/llmhub

# ============================================================= frontend =====
# Not needed until the frontend is deployed. See README, "Frontend".

# Better Auth. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin the browser reaches (must match the CILogon redirect URI).
BETTER_AUTH_URL=

# CILogon OAuth — registered by the LLMHub maintainers, not self-serve.
CILOGON_CLIENT_ID=
CILOGON_CLIENT_SECRET=
CILOGON_DISCOVERY_URL=
CILOGON_SKIN=

# Pepper for hashing user-issued API keys.
# Rotating this invalidates every existing user API key. openssl rand -hex 32
USER_API_KEY_PEPPER=

# Always-on vLLM endpoint backing the default chat experience.
ALWAYS_ON_VLLM_BASE_URL=
ALWAYS_ON_VLLM_API_KEY=
ALWAYS_ON_VLLM_MODEL=

# Object storage for uploads and attachments.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_SIGNED_URL_TTL_SECONDS=
